{
  "name": "mmms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Machine Maintenance Management System API",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:create": "node src/create-database.js",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "test": "node --test",
    "test:integration": "node tools/run-integration-tests.cjs",
    "docker:config": "docker compose --env-file .env.deploy -f compose.independent.yaml config --quiet",
    "docker:build": "docker compose --env-file .env.deploy -f compose.independent.yaml build",
    "docker:up": "docker compose --env-file .env.deploy -f compose.independent.yaml up -d --build",
    "docker:logs": "docker compose --env-file .env.deploy -f compose.independent.yaml logs --tail=100 -f",
    "docker:migrate": "docker compose --env-file .env.deploy -f compose.independent.yaml --profile maintenance run --rm --build migrate",
    "docker:customer": "docker compose --env-file .env.deploy -f compose.independent.yaml -f compose.customer.yaml up -d --build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express-rate-limit": "^8.0.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
